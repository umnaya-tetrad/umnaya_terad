# Server environment only. AdapterConfig.from_env() does not load this file.
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_MODEL=google/gemini-3.8-flash
POLZA_PROVIDER=google-ai-studio/flex
# New reference recommendation; benchmark tested 12000 and 24000, not 25000.
POLZA_MAX_COMPLETION_TOKENS=25000
# HTTPX read/write/pool inactivity timeout, NOT total wall-clock deadline.
POLZA_TIMEOUT_SECONDS=300
POLZA_CONNECT_TIMEOUT_SECONDS=15
# Dated tested price caps, RUB/M tokens, 2026-11-19; verify before deployment.
POLZA_MAX_PRICE_PROMPT=50
POLZA_MAX_PRICE_COMPLETION=250
POLZA_MAX_PRICE_IMAGE=50
