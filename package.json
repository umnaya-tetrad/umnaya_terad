{
  "name": "smartnote-pilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "test:browser": "node scripts/pilot/browser_smoke.mjs",
    "test:browser:compose": "node scripts/pilot/browser_compose_smoke.mjs",
    "test:browser:followups:compose": "node scripts/pilot/browser_followups_compose.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "katex": "0.18.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
